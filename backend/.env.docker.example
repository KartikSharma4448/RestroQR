# Copy to .env.docker and replace placeholders privately.
# Compose injects DATABASE_URL and TABLE_TOKEN_SECRET from the host environment.
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-an-independent-random-secret
CUSTOMER_BASE_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://127.0.0.1:3001,http://127.0.0.1:8080
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
