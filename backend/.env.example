# Database
DATABASE_URL=postgresql://user:password@localhost:5432/restroqr

# Test Database (used by test suite)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/restroqr_test

# Authentication
JWT_SECRET=your-jwt-secret-here

# Resend transactional email (leave blank until the sending domain is verified)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Upcoming owner email verification: independent random secret, at least 32 bytes
# EMAIL_OTP_SECRET=
# Upcoming Google authentication: public server/web OAuth client ID
# GOOGLE_CLIENT_ID=
# Keep disabled until migration 014, Flutter Google flow and service account are ready.
GOOGLE_OWNER_AUTH_ENABLED=false
OWNER_EMAIL_SIGNUP_ENABLED=false
OWNER_PROFILE_ACTIVATION_ENABLED=false
FIREBASE_PROJECT_ID=restroqr2

# Cloudinary (Image Storage)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Table Token Encryption (32-byte hex key or passphrase)
TABLE_TOKEN_SECRET=your-table-token-secret-here-must-be-32-bytes

# QR customer website origin
CUSTOMER_BASE_URL=http://127.0.0.1:3001

# Optional private Firebase service-account file path for push delivery
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:3001

# Admin Seed (used only by `npm run seed` command)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=YourStr0ng!PassHere12
MENU_MEDIA_ENABLED=false
MENU_OPTIONS_ENABLED=false
CUSTOMER_EMAIL_ORDERING_ENABLED=false
ORDER_EMAIL_DELIVERY_ENABLED=false
# Queue a payment receipt only after authenticated owner payment confirmation.
PAYMENT_RECEIPT_EMAIL_ENABLED=false
ORDER_PAYMENTS_ENABLED=false
ORDER_LIFECYCLE_EMAIL_ENABLED=false
# Optional UTC cutoff for controlled local activation; older queued emails stay unsent.
ORDER_EMAIL_DELIVERY_NOT_BEFORE=
WAITER_CALLING_ENABLED=false
# Migration 024 and customer-email/payment-receipt flags are prerequisites.
LOYALTY_ENABLED=false
CUSTOMER_REVIEWS_ENABLED=false
